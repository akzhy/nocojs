{
  "name": "lazy-workspace",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/rollup-plugin/example",
    "packages/webpack-loader/example",
    "packages/rspack-loader/example",
    "packages/parcel-transformer/example"
  ],
  "scripts": {
    "build:all": "lerna run build",
    "build:packages": "lerna run build --ignore '@nocojs/*example*' --ignore '*example*'",
    "build:non-core-packages": "lerna run build --ignore '@nocojs/*example*' --ignore '*example*' --ignore '@nocojs/core' --no-bail",
    "build:core-rust": "lerna run build --scope '@nocojs/core'",
    "build:core-js": "lerna run build:js --scope '@nocojs/core'",
    "changeset": "changeset",
    "biome:check": "lerna run biome:check",
    "biome:check:fix": "lerna run biome:check -- --fix",
    "biome:check:changed": "lerna run biome:check -- --changed"
  },
  "dependencies": {
    "@changesets/cli": "^2.29.5"
  },
  "devDependencies": {
    "lefthook": "^2.0.0",
    "lerna": "^8.2.3"
  }
}
