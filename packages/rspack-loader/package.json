{
  "name": "@nocojs/rspack-loader",
  "author": "akzhy <hi@akzhy.com>",
  "version": "1.0.1-beta.1",
  "description": "Rspack loader for @nocojs/core transformations",
  "main": "dist/cjs/index.js",
  "types": "dist/types/index.d.ts",
  "module": "dist/esm/index.js",
  "repository": "git@github.com:akzhy/nocojs.git",
  "license": "MIT",
