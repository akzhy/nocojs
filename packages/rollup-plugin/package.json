{
  "name": "@nocojs/rollup-plugin",
  "author": "akzhy <hi@akzhy.com>",
  "version": "1.0.0",
  "description": "Rollup plugin for nocojs image optimization",
  "main": "dist/cjs/index.js",
  "types": "dist/types/index.d.ts",
  "module": "dist/esm/index.js",
  "license": "MIT",
  "repository": "git@github.com:akzhy/nocojs.git",
  "keywords": [
    "rollup",
    "plugin",
    "image",
    "optimization",
    "nocojs",
    "lazy-loading"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c",
    "dev": "rolldown --watch -c",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "biome:check": "biome check",
    "biome:check:fix": "biome check --fix",
    "lint": "biome lint",
    "format": "biome format"
  },
  "dependencies": {
    "@nocojs/core": "workspace:*",
    "picomatch": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "rolldown": "catalog:",
    "rollup": "^4.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "rollup": "^2.0.0 || ^3.0.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
