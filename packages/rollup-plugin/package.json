{
  "name": "@nocojs/rollup-plugin",
  "author": "akzhy <hi@akzhy.com>",
  "version": "1.0.1-beta.0",
  "description": "Rollup plugin for nocojs image optimization",
  "main": "dist/cjs/index.js",
  "types": "dist/types/index.d.ts",
  "module": "dist/esm/index.js",
  "license": "MIT",
  "repository": "git@github.com:akzhy/nocojs.git",
  "keywords": [
    "rollup",
    "plugin",
    "image",
    "optimization",
    "nocojs",
    "lazy-loading"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c",
    "dev": "rolldown --watch -c",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "biome:check": "biome check",
    "biome:check:fix": "biome check --fix",
    "lint": "biome lint",
    "format": "biome format"
  },
  "dependencies": {
    "nocojs": "*",
    "picomatch": "^4.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^24.2.0",
    "@types/picomatch": "^4.0.2",
    "rolldown": "^1.0.0-beta.34",
    "rollup": "^4.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "rollup": "^2.0.0 || ^3.0.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
