{
  "name": "@nocojs/webpack-loader",
  "author": "akzhy <hi@akzhy.com>",
  "version": "1.0.1-beta.0",
  "description": "Webpack loader for @nocojs/core transformations",
  "main": "dist/cjs/index.js",
  "types": "dist/types/index.d.ts",
  "module": "dist/esm/index.js",
  "repository": "git@github.com:akzhy/nocojs.git",
  "license": "MIT",
  "keywords": [
    "webpack",
    "loader",
    "nocojs",
    "image",
    "transform"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">= 14.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rolldown -c",
    "dev": "rolldown --watch -c",
    "test": "vitest",
    "biome:check": "biome check",
    "biome:check:fix": "biome check --fix",
    "lint": "biome lint",
    "format": "biome format"
  },
  "dependencies": {
    "loader-utils": "^3.3.1",
    "nocojs": "^1.0.1-beta.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/loader-utils": "^2.0.6",
    "@types/node": "^20.0.0",
    "rolldown": "^1.0.0-beta.34",
    "typescript": "^5.9.2",
    "vitest": "^1.0.0",
    "webpack": "^5.101.0"
  },
  "peerDependencies": {
    "webpack": "^5.0.0"
  }
}
